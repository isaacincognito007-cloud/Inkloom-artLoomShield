# LoomShield Environment Configuration Reference
# ==============================================================================

# 1. Deployment and Workspace Mode
# LOOMSHIELD_DEPLOYMENT: 'local' (development / on-device) or 'hosted' (cloud / Render)
# Defaults to 'hosted' if unset; run_loomshield.py defaults to 'local'.
LOOMSHIELD_DEPLOYMENT=local

# LOOMSHIELD_WORKSPACE_MODE: 'demo' (labelled demo workspace with sample data & role preview)
# or 'production' (clean workspace, role preview disabled). Defaults to 'production'.
LOOMSHIELD_WORKSPACE_MODE=production

# 2. Server Identity & Role Enforced
# LOOMSHIELD_USER_ROLE: Role enforced by server in production.
# Options: 'Brand Administrator', 'Reviewer', 'Content Creator'.
# In local deployment defaults to 'Brand Administrator'. In hosted production defaults to 'Content Creator'.
LOOMSHIELD_USER_ROLE=Brand Administrator

# LOOMSHIELD_USER_NAME: Display name used in audit history and event records.
LOOMSHIELD_USER_NAME=Workspace Administrator

# 3. Storage and Persistence
# LOOMSHIELD_DB_PATH: Path to SQLite database file.
# On hosted platforms (e.g. Render), set to a mounted persistent disk (e.g. /var/data/loomshield.db)
# to ensure audits and guidelines survive restarts and redeployments.
# LOOMSHIELD_DB_PATH=/var/data/loomshield.db

# LOOMSHIELD_STORAGE: 'persistent' or 'ephemeral' (reported in system status diagnostics).
# Defaults to 'persistent' if deployment is local or LOOMSHIELD_DB_PATH is set; otherwise 'ephemeral'.
LOOMSHIELD_STORAGE=persistent

# 4. Processing and Resource Limits
# LOOMSHIELD_MAX_UPLOAD_MB: Maximum uploaded document size in MB.
# Note: Currently enforced at 5 MB in Phase 1; background-job large uploads planned for Phase 3.
LOOMSHIELD_MAX_UPLOAD_MB=5

# LOOMSHIELD_MAX_PDF_PAGES: Maximum pages processed in a single PDF audit (default: 100).
LOOMSHIELD_MAX_PDF_PAGES=100

# 5. Network and Security
# LOOMSHIELD_CORS_ORIGINS: Comma-separated allowed origins (e.g. https://inkloom-artloomshield-frontend.vercel.app)
# If set to '*', allow_credentials will be set to False for security.
LOOMSHIELD_CORS_ORIGINS=https://inkloom-artloomshield-frontend.vercel.app
